---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = "October 26, 2026";
---

<BaseLayout
  title="Disclaimer | Jamie Ian West"
  description="Disclaimer and legal terms for information provided on jamieianwest.com."
>
  <nav class="links" aria-label="Navigation and Profiles">
    <a href="/">Home</a>
    <a href="/blog/">Blog</a>
    <a href="https://github.com/Jamian/" target="_blank" rel="noopener noreferrer me" aria-label="GitHub Profile">GitHub</a>
    <a href="https://www.linkedin.com/in/jamieianwest/" target="_blank" rel="noopener noreferrer me" aria-label="LinkedIn Profile">LinkedIn</a>
    <a href="mailto:hello@jamieianwest.com" aria-label="Send Email">Email</a>
  </nav>

  <main class="disclaimer-container">
    <h1>Disclaimer</h1>
    <p class="last-updated">Last Updated: {lastUpdated}</p>

    <div class="content">
      <p>
        The information provided by Jamie Ian West ("we," "us," or "our") on 
        <a href="https://jamieianwest.com"> https://jamieianwest.com</a> (the "Site") is for general informational purposes only. 
