---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="Jamie West | DevSecOps, Platform Engineering & Cloud Security"
  description="Jamie West is a security-focused Cloud Engineering, DevSecOps, and Platform Engineering professional helping high-performing organisations remain secure without sacrificing velocity."
>

    <h1>Jamie West</h1>
    <h2>Secure &ne; Slow.</h2>
    <p>
        <span class="main-tagline">Hello! I’m Jamie, a security-focused Cloud Engineering, DevSecOps, and Platform Engineering professional.</span>
        <span class="intro-text">We all get our kicks somewhere; for me, it's helping high-performing organisations build resilient cloud infrastructure and DevSecOps practices without sacrificing velocity. If this aligns with your goals, please get in touch:</span>
    </p>

    <nav class="links" aria-label="Navigation and Profiles">
        <a href="/blog/">Blog</a>
        <a href="https://github.com/Jamian/" target="_blank" rel="noopener noreferrer me" aria-label="GitHub Profile">GitHub</a>
        <a href="https://www.linkedin.com/in/jamieianwest/" target="_blank" rel="noopener noreferrer me" aria-label="LinkedIn Profile">LinkedIn</a>
        <a href="mailto:hello@jamieianwest.com" aria-label="Send Email">Email</a>
    </nav>

    {latestPosts.length > 0 && (
        <section class="home-latest-posts" aria-label="Latest Blog Posts">
            <h3 class="home-section-label">// Latest Writing</h3>
            <ul class="home-post-list">
                {latestPosts.map((post) => (
                    <li>
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </li>
                ))}
            </ul>
        </section>
    )}

    <div class="qr" aria-hidden="true">
