---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog | Jamie West"
  description="Writing about Cloud Architecture, DevSecOps, Platform Engineering, the humans behind the systems, mental health, and burnout."
  containerClass="wide-container"
>
    <div style="margin-bottom: 2rem;">
        <nav style="margin-bottom: 1.5rem;">
            <a href="/" style="text-decoration: none; color: inherit; font-size: 0.9rem; border: 1px solid #555; padding: 6px 14px; display: inline-block;">
                &larr; Home
            </a>
        </nav>

        <h1>Blog</h1>
        <h2>Secure &ne; Slow.</h2>
        <p style="margin-left: 0; margin-bottom: 0.8rem;">
            Writing about Cloud Architecture, DevSecOps, Platform Engineering, the humans behind the systems, and navigating mental health and burnout in tech.
        </p>
        <p style="margin-left: 0; margin-bottom: 2rem; font-size: 0.85rem; color: #777;">
            // All opinions expressed here are strictly my own.
        </p>
    </div>

    <section>
        {posts.length === 0 ? (
            <p>No posts published yet. Check back soon!</p>
        ) : (
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                {posts.map((post) => {
                    const formattedDate = post.data.pubDate.toLocaleDateString('en-GB', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                    });

                    return (
                        <article style="border: 1px solid #555; padding: 1.5rem; transition: border-color 0.2s;">
                            <div class="post-meta" style="margin-bottom: 0.5rem;">
                                <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                                {post.data.tags && post.data.tags.map((tag: string) => (
                                    <span class="tag-badge">#{tag}</span>
                                ))}
                            </div>
                            
                            <h3 style="margin-bottom: 0.6rem; font-size: 1.3rem;">
                                <a href={`/blog/${post.id}/`} style="text-decoration: none; color: inherit;">
                                    {post.data.title}
                                </a>
                            </h3>

                            <p style="color: #666; margin-bottom: 1rem; font-size: 0.9rem;">
                                {post.data.description}
                            </p>

                            <a href={`/blog/${post.id}/`} style="color: inherit; text-decoration: underline; text-underline-offset: 4px; font-size: 0.85rem;">
                                Read article &rarr;
                            </a>
                        </article>
                    );
                })}
            </div>
        )}
    </section>

    <div style="margin-top: 3rem; text-align: center;">
        <a href="/rss.xml" style="font-size: 0.8rem; color: inherit; text-decoration: none; border: 1px solid #666; padding: 4px 10px;">
            RSS Feed
        </a>
    </div>
</BaseLayout>

